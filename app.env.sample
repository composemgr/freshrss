# FreshRSS environment configuration
# Copy to app.env and customize before starting

# Timezone
TZ=America/New_York

# Hostname
BASE_HOST_NAME=freshrss.example.com

# Admin user (created on first run)
APP_ADMIN_USER=admin
APP_ADMIN_PASS=changeme_admin_password

# Database (PostgreSQL)
DB_CREATE_DATABASE_NAME=freshrss
DB_USER_NAME=freshrss
DB_USER_PASS=changeme_db_password

# From-address used during install
EMAIL_SERVER_MAIL_FROM=admin@example.com
